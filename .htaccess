# .htaccess — Caché agresivo para assets estáticos
# Requiere mod_headers, mod_expires, mod_rewrite en Apache (XAMPP los trae)

# ------------------------------------------------------------------ CODIFICACIÓN
# Todos los archivos son UTF-8 SIN BOM. Si el Apache de otra computadora trae
# "AddDefaultCharset ISO-8859-1" (o ningún charset), el navegador interpreta
# mal los acentos y la ñ y la página se ve con caracteres extraños. Fijarlo
# aquí garantiza la misma lectura en cualquier servidor.
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
    AddType "text/html; charset=UTF-8" .html .htm
    AddType "text/css; charset=UTF-8" .css
    AddType "application/javascript; charset=UTF-8" .js
</IfModule>

# Página de inicio explícita: sin esto, un servidor con otra configuración
# puede mostrar el listado de archivos en lugar de la tienda.
DirectoryIndex index.html index.htm index.php

# Nunca listar el contenido de una carpeta (equivalente no agresivo a
# "Options -Indexes", que sí puede dar error 500 con AllowOverride restrictivo).
<IfModule mod_autoindex.c>
    IndexIgnore *
</IfModule>

# Los errores de PHP van al registro, NO a la pantalla: un simple "Warning"
# impreso antes del <!DOCTYPE es la causa clásica de texto extraño al inicio
# de la página en servidores ajenos.
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>
<IfModule mod_php7.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>
<IfModule mod_php8.c>
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML: sin caché (cambia dinámicamente)
    ExpiresByType text/html "access plus 0 seconds"

    # CSS/JS: 1 año con versionado (?v=X)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Fuentes: 1 año
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # Imágenes: 1 año
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"

    # JSON/XML: 1 hora
    ExpiresByType application/json "access plus 1 hour"
    ExpiresByType application/xml "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
    # CSS y JS: se guardan pero SIEMPRE se revalidan. Con "immutable" un
    # archivo corregido seguía sirviéndose viejo durante un año en cualquier
    # computadora que ya hubiera abierto la página, aunque el código nuevo
    # estuviera en el servidor (eso rompía la tienda en equipos ajenos).
    # El ?v= de las etiquetas <link>/<script> sigue siendo el mecanismo
    # principal para forzar la descarga de una versión nueva.
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # Imágenes y fuentes (1 año, inmutable): casi nunca cambian.
    <FilesMatch "\.(woff2|woff|webp|avif|jpg|jpeg|png|svg|gif|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # HTML: no cachear (siempre fresco)
    <FilesMatch "\.html$">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # API PHP: no cachear (datos dinámicos)
    <FilesMatch "\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Seguridad básica
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Forzar HTTPS en producción (descomenta en prod)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Compresión GZIP/DEFLATE
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml font/woff2 font/woff image/svg+xml
    <IfModule mod_setenvif.c>
        BrowserMatch ^Mozilla/4 gzip-only-text/html
        BrowserMatch ^Mozilla/4\.0[678] no-gzip
        BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
    </IfModule>
</IfModule>

# Desactivar ETags (usamos versionado en URL: ?v=X)
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None